{
  "name": "taste-review",
  "private": true,
  "type": "module",
  "workspaces": [
    "site"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w site",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5"
  }
}
